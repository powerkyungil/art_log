<section class="section-card assignment-progress-card">
  <form method="get" action="/admin/progress" class="filters">
    <label>관리 월<input type="month" name="month" value="<%= month %>" required></label>
    <label class="filter-search">작가 검색<input type="search" name="search" value="<%= dashboard.filters.search %>" placeholder="작가명"></label>
    <label>현재 상태<select name="status">
      <option value="">전체 상태</option>
      <option value="SUBMITTED" <%= dashboard.filters.status === 'SUBMITTED' ? 'selected' : '' %>>제출</option>
      <option value="CONFIRMED" <%= dashboard.filters.status === 'CONFIRMED' ? 'selected' : '' %>>확인완료</option>
      <option value="NOT_SUBMITTED" <%= dashboard.filters.status === 'NOT_SUBMITTED' ? 'selected' : '' %>>미제출</option>
    </select></label>
    <button class="button button-secondary" type="submit">필터 적용</button>
  </form>

  <% if (!dashboard.assignments.length) { %>
    <div class="empty-state">공개된 과제를 먼저 등록해주세요.</div>
  <% } else if (!dashboard.artists.length) { %>
    <div class="empty-state">표시할 작가가 없습니다.</div>
  <% } else { %>
    <% const visibleGroups = dashboard.assignmentGroups.filter((group) => group.assignments.some((assignment) => dashboard.artists.some((artist) => artist.weeks.find((item) => item.assignmentId === assignment.id)?.applicable))); %>
    <% if (!visibleGroups.length) { %>
      <div class="empty-state">배정된 과제가 없습니다.</div>
    <% } else { %>
    <div class="week-group-actions">
      <span class="small-text muted-text">주차를 펼친 뒤 작가별 항목을 열면 해당 작가에게 배정된 과제만 확인할 수 있습니다.</span>
      <div class="actions">
        <button class="button button-secondary button-small" type="button" data-week-expand-all>전체 펼치기</button>
        <button class="button button-secondary button-small" type="button" data-week-collapse-all>전체 접기</button>
      </div>
    </div>
    <div class="week-groups" data-week-groups>
      <% visibleGroups.forEach((group) => { %>
        <section class="week-group <%= group.isCurrent ? 'is-current is-expanded' : '' %>" data-week-group>
          <button class="week-group-header" type="button" data-week-toggle aria-expanded="<%= group.isCurrent ? 'true' : 'false' %>">
            <span class="week-group-heading">
              <strong><%= group.week %>주차</strong>
              <span class="badge badge-info"><%= group.assignments.length %>개 과제</span>
              <% if (group.applicableCount) { %><span class="small-text muted-text"><%= group.submittedCount %>/<%= group.applicableCount %> 제출</span><% } %>
            </span>
            <span class="week-group-state"><%= group.isCurrent ? '현재 진행 중' : '상세 보기' %><span class="week-toggle-icon" aria-hidden="true">⌄</span></span>
          </button>
          <div class="week-group-content" data-week-content<% if (!group.isCurrent) { %> hidden<% } %>>
            <div class="week-dashboard">
              <div class="artist-week-list">
                <% dashboard.artists.forEach((artist) => { %>
                  <% const applicableAssignments = group.assignments.filter((assignment) => artist.weeks.find((item) => item.assignmentId === assignment.id)?.applicable); %>
                  <article class="artist-week-dropdown" data-week-artist-dropdown>
                    <button class="artist-week-toggle" type="button" data-week-artist-toggle aria-expanded="false">
                      <span class="artist-week-toggle-main">
                        <strong><%= displayName(artist.name) %></strong>
                        <span class="progress-cell">
                          <span class="progress" title="<%= artist.progressRate %>%"><span class="progress-bar" style="width:<%= artist.progressRate %>%"></span></span>
                          <span class="small-text"><%= artist.progressRate %>%</span>
                        </span>
                      </span>
                      <span class="week-group-state">과제 보기<span class="week-toggle-icon" aria-hidden="true">⌄</span></span>
                    </button>
                    <div class="artist-week-content" data-week-artist-content hidden>
                      <% if (!applicableAssignments.length) { %>
                        <div class="empty-state compact-empty">배정된 과제가 없습니다.</div>
                      <% } else { %>
                        <div class="assignment-list">
                          <% applicableAssignments.forEach((assignment) => { %>
                            <% const week = artist.weeks.find((item) => item.assignmentId === assignment.id); %>
                            <div class="assignment-list-item">
                              <div class="assignment-list-main">
                                <strong class="assignment-list-title"><%= assignment.title %></strong>
                                <span class="small-text muted-text"><%= assignment.topic %> · 마감 <%= formatDateTime(assignment.due_at) %></span>
                              </div>
                              <% if (week.postUrl) { %>
                                <a class="badge badge-<%= statusClass(week.status) %>" href="<%= week.postUrl %>" target="_blank" rel="noopener noreferrer"><%= statusLabel(week.status) %></a>
                              <% } else { %>
                                <span class="badge badge-<%= statusClass(week.status) %>"><%= statusLabel(week.status) %></span>
                              <% } %>
                            </div>
                          <% }) %>
                        </div>
                      <% } %>
                    </div>
                  </article>
                <% }) %>
              </div>
            </div>
          </div>
        </section>
      <% }) %>
    </div>
    <% } %>
  <% } %>
</section>
