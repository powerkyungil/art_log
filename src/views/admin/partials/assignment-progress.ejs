<section class="section-card assignment-progress-card">
  <form method="get" action="/admin/progress" class="filters">
    <label class="filter-search">작가 검색<input type="search" name="search" value="<%= dashboard.filters.search %>" placeholder="작가명"></label>
    <button class="button button-secondary" type="submit">필터 적용</button>
  </form>

  <% const assignmentStatusList = (artist) => {
    if (Array.isArray(artist.assignmentStatuses)) return artist.assignmentStatuses;
    if (artist.assignmentStatuses instanceof Map) return [...artist.assignmentStatuses.values()];
    if (artist.assignments instanceof Map) return [...artist.assignments.values()];
    return [];
  }; %>
  <% const emptyAssignmentStatus = { status: 'NOT_SUBMITTED', submittedAt: null, postUrl: null, postUrls: [] }; %>

  <% if (!dashboard.assignments.length) { %>
    <div class="empty-state">공개된 미션을 먼저 등록해주세요.</div>
  <% } else if (!dashboard.artists.length) { %>
    <div class="empty-state">표시할 활동 작가가 없습니다.</div>
  <% } else { %>
    <% const visibleGroups = dashboard.assignmentGroups.filter((group) => group.assignments.some((assignment) => dashboard.artists.some((artist) => assignmentStatusList(artist).find((item) => item.assignmentId === assignment.id)?.applicable))); %>
    <% if (!visibleGroups.length) { %>
      <div class="empty-state">등록된 미션이 없습니다.</div>
    <% } else { %>
      <div class="mission-list">
        <% visibleGroups.forEach((group) => { %>
          <% const mission = group.assignments[0]; %>
          <article class="mission-card" data-mission-card>
            <div class="mission-card-header">
              <div>
                <div class="eyebrow">MISSION <%= group.roundNo %></div>
                <h2>미션 <%= group.roundNo %></h2>
                <h3 class="mission-card-title"><%= mission.title %></h3>
              </div>
              <div class="mission-card-meta">
                <% if (group.isCurrent) { %><span class="badge badge-info">현재 진행 중</span><% } %>
                <span class="small-text muted-text">마감 <%= formatDateTime(mission.due_at) %></span>
              </div>
            </div>

            <div class="mission-overview" aria-label="미션 <%= group.roundNo %> 전체 현황">
              <div class="mission-overview-heading">
                <strong>전체 현황</strong>
                <strong><%= group.submittedCount %>/<%= group.applicableCount %> 완료 · <%= group.progressRate %>%</strong>
              </div>
              <div class="progress" role="progressbar" aria-label="미션 <%= group.roundNo %> 완료율" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= group.progressRate %>">
                <div class="progress-bar" style="width:<%= group.progressRate %>%"></div>
              </div>
            </div>

            <div class="mission-sections">
              <details class="mission-section">
                <summary class="mission-section-summary">
                  <span class="mission-section-heading"><strong>미션 내용</strong><span class="small-text muted-text">제목 · 주제 · 내용</span></span>
                  <span class="mission-section-toggle" aria-hidden="true"><span class="mission-section-closed">보기</span><span class="mission-section-open">닫기</span><span class="mission-section-icon"></span></span>
                </summary>
                <div class="mission-content-details">
                  <div class="mission-content-row"><span class="detail-label">제목</span><strong><%= mission.title %></strong></div>
                  <div class="mission-content-row"><span class="detail-label">주제</span><span><%= mission.topic %></span></div>
                  <div class="mission-content-row"><span class="detail-label">내용</span><span class="mission-content-description"><%= mission.description || '등록된 미션 설명이 없습니다.' %></span></div>
                </div>
              </details>

              <details class="mission-section">
                <summary class="mission-section-summary">
                  <span class="mission-section-heading"><strong>작가별 현황</strong><span class="small-text muted-text">모든 활동 작가 공통 미션</span></span>
                  <span class="mission-section-toggle" aria-hidden="true"><span class="mission-section-closed">보기</span><span class="mission-section-open">닫기</span><span class="mission-section-icon"></span></span>
                </summary>
                <div class="mission-artists">
                  <div class="mission-artist-list">
                    <% dashboard.artists.forEach((artist) => { %>
                      <% const assignmentStatus = assignmentStatusList(artist).find((item) => item.assignmentId === mission.id) || emptyAssignmentStatus; %>
                      <% const completed = ['SUBMITTED', 'CONFIRMED'].includes(assignmentStatus.status); %>
                      <div class="mission-artist-row">
                        <div class="mission-artist-main">
                          <strong><%= displayName(artist.name) %></strong>
                          <% if (assignmentStatus.submittedAt) { %>
                            <span class="small-text muted-text">제출 <%= formatDateTime(assignmentStatus.submittedAt) %></span>
                          <% } else { %>
                            <span class="small-text muted-text">아직 제출하지 않았습니다.</span>
                          <% } %>
                        </div>
                        <div class="mission-artist-actions">
                          <span class="badge badge-<%= statusClass(assignmentStatus.status) %>"><%= completed ? '완료' : '미완료' %></span>
                          <% if (assignmentStatus.postUrls?.length) { %><%- include('../../partials/submission-urls', { urls: assignmentStatus.postUrls, compact: true }) %><% } %>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                </div>
              </details>
            </div>
          </article>
        <% }) %>
      </div>

      <%- include('./pagination', { pagination: dashboard.pagination }) %>
    <% } %>
  <% } %>
</section>
