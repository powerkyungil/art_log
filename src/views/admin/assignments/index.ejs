<%- include('../../partials/admin-head', { title }) %>

<div class="page-heading">
  <div><div class="eyebrow">MISSIONS</div><h1>미션 관리</h1><p>전체 미션 번호와 공개 상태를 관리합니다.</p></div>
  <a class="button button-primary" href="/admin/assignments/new">미션 등록</a>
</div>

<section class="section-card">
  <% if (!assignments.length) { %><div class="empty-state">등록된 미션이 없습니다.</div><% } else { %>
    <div class="table-wrap"><table>
      <thead><tr><th>미션</th><th>제목</th><th>주제</th><th>제출 기간</th><th>대상</th><th>공개</th><th></th></tr></thead>
      <tbody>
        <% assignments.forEach((assignment) => { %><tr>
          <td><strong>미션 <%= assignment.round_no %></strong></td>
          <td><strong><%= assignment.title %></strong><br><span class="muted-text small-text"><%= assignment.description || '' %></span></td>
          <td><%= assignment.topic %></td>
          <td><%= formatDateTime(assignment.start_at) %><br>~ <%= formatDateTime(assignment.due_at) %></td>
          <td>전체 활동 작가</td>
          <td><span class="badge badge-<%= assignment.is_visible ? 'success' : 'muted' %>"><%= assignment.is_visible ? '공개' : '비공개' %></span></td>
          <td><div class="actions">
            <a class="button button-secondary button-small" href="/admin/assignments/<%= assignment.id %>/edit">수정</a>
            <form method="post" action="/admin/assignments/<%= assignment.id %>/toggle" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-secondary button-small" type="submit"><%= assignment.is_visible ? '비공개' : '공개' %></button></form>
            <form method="post" action="/admin/assignments/<%= assignment.id %>/delete" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-danger button-small" type="submit" data-confirm="미션 <%= assignment.round_no %>과 관련 제출 내역을 모두 삭제할까요?">삭제</button></form>
          </div></td>
        </tr><% }) %>
      </tbody>
    </table></div>
  <% } %>
</section>

<%- include('../../partials/admin-foot') %>
