<%- include('../../partials/admin-head', { title }) %>

<div class="page-heading">
  <div><div class="eyebrow">MISSION</div><h1><%= title %></h1><p>미션 번호는 전체 미션 기준으로 자동 증가하며, 제출 시작일 이후 진행률에 포함됩니다.</p></div>
  <a class="button button-secondary" href="/admin/assignments">목록으로</a>
</div>

<section class="section-card">
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <form method="post" action="<%= mode === 'create' ? '/admin/assignments' : `/admin/assignments/${assignment.id}` %>" class="stack-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-grid">
      <label>미션 번호<input type="text" value="<%= assignment.round_no ? `미션 ${assignment.round_no}` : '등록 시 자동 부여' %>" readonly></label>
      <label>권장 업로드 채널<select name="recommended_channel"><option value="">선택 안 함</option><% channels.forEach((channel) => { %><option value="<%= channel %>" <%= assignment.recommended_channel === channel ? 'selected' : '' %>><%= channel %></option><% }) %></select></label>
      <label class="full">미션 제목 *<input type="text" name="title" value="<%= assignment.title || '' %>" maxlength="255" required></label>
      <label class="full">미션 주제 *<input type="text" name="topic" value="<%= assignment.topic || '' %>" maxlength="255" required></label>
      <label class="full">미션 설명<textarea name="description"><%= assignment.description || '' %></textarea></label>
      <label>제출 시작일 *<input type="datetime-local" name="start_at" value="<%= toDateTimeLocal(assignment.start_at) %>" required></label>
      <label>제출 마감일 *<input type="datetime-local" name="due_at" value="<%= toDateTimeLocal(assignment.due_at) %>" required></label>
      <div class="full common-mission-target">
        <span class="detail-label">미션 대상</span>
        <div class="common-mission-target-box">
          <span class="badge badge-info">전체 활동 작가</span>
          <span class="small-text muted-text">모든 활동중 작가에게 동일한 미션이 표시되며, 작가별 제출 여부를 확인할 수 있습니다.</span>
        </div>
      </div>
      <label class="checkbox full"><input type="checkbox" name="is_visible" value="1" <%= assignment.is_visible ? 'checked' : '' %>> 작가에게 공개</label>
    </div>
    <div class="actions"><button class="button button-primary" type="submit"><%= mode === 'create' ? '미션 등록' : '수정 저장' %></button><a class="button button-secondary" href="/admin/assignments">취소</a></div>
  </form>
</section>

<%- include('../../partials/admin-foot') %>
