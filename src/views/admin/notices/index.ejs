<%- include('../../partials/admin-head', { title }) %>

<div class="page-heading">
  <div><div class="eyebrow">NOTICES</div><h1>공지사항</h1><p>작가 홈에 노출할 공지사항을 관리합니다.</p></div>
  <a class="button button-primary" href="/admin/notices/new">공지 등록</a>
</div>

<section class="section-card">
  <% if (!notices.length) { %><div class="empty-state">등록된 공지사항이 없습니다.</div><% } else { %>
    <div class="notice-list">
      <% notices.forEach((notice) => { %><article class="notice-item">
        <div class="admin-notice-meta"><span class="badge admin-notice-status badge-<%= notice.is_visible ? 'success' : 'muted' %>"><%= notice.is_visible ? '공개 중' : '비공개' %></span><% if (notice.is_pinned) { %><span class="badge badge-info">상단 고정</span><% } %></div>
        <h3 class="admin-notice-title"><a class="admin-notice-title-link" href="/admin/notices/<%= notice.id %>"><%= notice.title %></a></h3>
        <div class="notice-content admin-notice-preview"><%= notice.content %></div>
        <div class="actions" style="margin-top:12px"><span class="muted-text small-text"><%= formatDateTime(notice.published_at || notice.created_at) %></span><a class="button button-secondary button-small" href="/admin/notices/<%= notice.id %>">상세 보기</a><a class="button button-secondary button-small" href="/admin/notices/<%= notice.id %>/edit">수정</a><form method="post" action="/admin/notices/<%= notice.id %>/toggle" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-secondary button-small" type="submit"><%= notice.is_visible ? '비공개' : '공개' %></button></form><form method="post" action="/admin/notices/<%= notice.id %>/delete" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-danger button-small" type="submit" data-confirm="이 공지사항을 삭제할까요?">삭제</button></form></div>
      </article><% }) %>
    </div>
    <%- include('../partials/pagination', { pagination }) %>
  <% } %>
</section>

<%- include('../../partials/admin-foot') %>
