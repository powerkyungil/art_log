<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Art Log</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="artist-page">
  <header class="site-header artist-header">
    <div class="container header-inner">
      <a class="brand" href="/artist" aria-label="SONY">SONY</a>
      <% if (artist) { %>
        <div class="header-user">
          <span><%= displayName(artist.name) %></span>
          <a class="button button-ghost button-small" href="/artist/password">비밀번호 변경</a>
          <form method="post" action="/artist/logout" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="button button-ghost button-small" type="submit">로그아웃</button>
          </form>
        </div>
      <% } %>
    </div>
  </header>
  <main class="container artist-main">
    <%- include('./flash') %>
