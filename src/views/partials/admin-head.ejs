<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Art Log</title>
  <link rel="icon" type="image/jpeg" href="/images/sony-logo.jpeg?v=20260818">
  <link rel="apple-touch-icon" href="/images/sony-logo.jpeg?v=20260818">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="admin-page">
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/admin" aria-label="SONY"><img src="/images/sony-logo.jpeg" alt="SONY"></a>
      <div class="header-user">
        <span><%= currentAdmin?.name || '관리자' %></span>
        <form method="post" action="/admin/logout" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="button button-ghost button-small" type="submit">로그아웃</button>
        </form>
      </div>
    </div>
  </header>
  <div class="container app-shell">
    <aside class="sidebar">
      <nav>
        <a class="nav-link <%= currentPath.startsWith('/admin/dashboard') || currentPath === '/admin' ? 'active' : '' %>" href="/admin/dashboard">대시보드</a>
        <a class="nav-link <%= currentPath.startsWith('/admin/progress') ? 'active' : '' %>" href="/admin/progress">미션 진행 현황</a>
        <a class="nav-link <%= currentPath.startsWith('/admin/artists') ? 'active' : '' %>" href="/admin/artists">작가 관리</a>
        <a class="nav-link <%= currentPath.startsWith('/admin/assignments') ? 'active' : '' %>" href="/admin/assignments">미션 관리</a>
        <a class="nav-link <%= currentPath.startsWith('/admin/submissions') ? 'active' : '' %>" href="/admin/submissions">제출 내역</a>
        <a class="nav-link <%= currentPath.startsWith('/admin/notices') ? 'active' : '' %>" href="/admin/notices">공지사항</a>
      </nav>
    </aside>
    <main class="main-content">
      <%- include('./flash') %>
