<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Art Log</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <main class="center-page">
    <div class="card narrow-card text-center">
      <div class="wordmark" aria-label="SONY">SONY</div>
      <div class="eyebrow">ART LOG</div>
      <h1><%= title %></h1>
      <p class="muted-text"><%= message %></p>
      <a class="button button-primary" href="/">처음으로</a>
    </div>
  </main>
</body>
</html>
