<%- include('../partials/artist-head', { title }) %>

<div class="page-heading">
  <div><div class="eyebrow">SUBMISSION</div><h1><%= title %></h1><p>미션 <%= assignment.round_no %> · <%= assignment.title %></p></div>
  <a class="button button-secondary" href="/artist">홈으로</a>
</div>

<section class="section-card">
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <div class="assignment-card" style="margin-bottom:18px"><strong>미션 주제</strong><p class="muted-text" style="margin:5px 0 0"><%= assignment.topic %></p><p class="small-text muted-text" style="margin:8px 0 0">마감 <%= formatDateTime(assignment.due_at) %></p></div>
  <form method="post" action="<%= submission?.id ? `/artist/submissions/${submission.id}` : '/artist/submissions' %>" class="stack-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="assignment_id" value="<%= assignment.id || submission?.assignment_id %>">
    <div class="form-grid">
      <label>업로드 날짜 *<input type="date" name="upload_date" value="<%= submission?.upload_date || '' %>" required></label>
      <label>업로드 채널 *<select name="upload_channel" required><option value="">선택해주세요</option><% channels.forEach((channel) => { %><option value="<%= channel %>" <%= submission?.upload_channel === channel ? 'selected' : '' %>><%= channel %></option><% }) %></select></label>
      <div class="full submission-urls-field">
        <span class="detail-label">게시물 URL *</span>
        <div class="submission-url-list" data-submission-url-list>
          <% const postUrlRows = submission?.post_urls?.length ? submission.post_urls : submission?.post_url ? [submission.post_url] : ['']; %>
          <% postUrlRows.forEach((postUrl, index) => { %>
            <div class="submission-url-row" data-submission-url>
              <label><span data-submission-url-label>게시물 URL <%= index + 1 %></span><input type="url" name="post_url" value="<%= postUrl %>" placeholder="https://..." inputmode="url" required></label>
              <button class="button button-secondary button-small" type="button" data-remove-submission-url>삭제</button>
            </div>
          <% }) %>
        </div>
        <template data-submission-url-template>
          <div class="submission-url-row" data-submission-url>
            <label><span data-submission-url-label>게시물 URL</span><input type="url" name="post_url" placeholder="https://..." inputmode="url" required></label>
            <button class="button button-secondary button-small" type="button" data-remove-submission-url>삭제</button>
          </div>
        </template>
        <button class="button button-secondary button-small submission-url-add" type="button" data-add-submission-url>+ URL 추가</button>
      </div>
    </div>
    <p class="small-text muted-text">게시물이 여러 개라면 URL을 추가해주세요. 모든 링크는 http:// 또는 https://로 시작해야 합니다.</p>
    <div class="actions"><button class="button button-primary" type="submit"><%= submission?.id ? '수정 저장' : '제출하기' %></button><a class="button button-secondary" href="/artist">취소</a></div>
  </form>
</section>

<%- include('../partials/artist-foot') %>
