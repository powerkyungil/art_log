<%- include('../partials/artist-head', { title }) %>

<section class="card narrow-card" style="margin: 30px auto">
  <div class="eyebrow">ACCOUNT</div>
  <h1>비밀번호 변경</h1>
  <p class="muted-text">다음 로그인부터 변경한 비밀번호를 사용합니다.</p>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <form method="post" action="/artist/password" class="stack-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>현재 비밀번호<input type="password" name="current_password" autocomplete="current-password" required></label>
    <label>새 비밀번호<input type="password" name="new_password" autocomplete="new-password" minlength="4" required></label>
    <label>새 비밀번호 확인<input type="password" name="password_confirmation" autocomplete="new-password" minlength="4" required></label>
    <div class="actions"><button class="button button-primary" type="submit">변경하기</button><a class="button button-secondary" href="/artist">취소</a></div>
  </form>
</section>

<%- include('../partials/artist-foot') %>
