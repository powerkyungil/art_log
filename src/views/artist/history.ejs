<%- include('../partials/artist-head', { title }) %>

<div class="page-heading">
  <div><div class="eyebrow">MY SUBMISSIONS</div><h1>나의 활동 내역</h1><p>미션별 제출 상태를 확인할 수 있습니다.</p></div>
  <a class="button button-secondary" href="/artist">홈으로</a>
</div>

<section class="section-card">
  <% if (!activity.length) { %><div class="empty-state">공개된 미션이 없습니다.</div><% } else { %>
    <div class="table-wrap"><table>
      <thead><tr><th>미션</th><th>제목</th><th>업로드 날짜</th><th>채널</th><th>게시물</th><th>상태</th><th></th></tr></thead>
      <tbody>
        <% activity.forEach((item) => { %><tr>
          <td>미션 <%= item.round_no %></td><td><%= item.title %></td><td><%= item.upload_date || '-' %></td><td><%= item.upload_channel || '-' %></td>
          <td><% if (item.post_url) { %><a href="<%= item.post_url %>" target="_blank" rel="noopener noreferrer">보기</a><% } else { %>-<% } %></td>
          <td><span class="badge badge-<%= statusClass(item.status || 'NOT_SUBMITTED') %>"><%= statusLabel(item.status || 'NOT_SUBMITTED') %></span></td>
          <td><% if (item.submission_id && item.status !== 'CONFIRMED') { %><a class="button button-secondary button-small" href="/artist/submissions/<%= item.submission_id %>/edit">수정</a><% } else if (!item.submission_id && item.start_at && new Date(item.start_at).getTime() <= Date.now()) { %><a class="button button-primary button-small" href="/artist/submissions/new?assignment_id=<%= item.assignment_id %>">제출</a><% } %></td>
        </tr><% }) %>
      </tbody>
    </table></div>
  <% } %>
</section>

<%- include('../partials/artist-foot') %>
