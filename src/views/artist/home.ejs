<%- include('../partials/artist-head', { title }) %>

<section class="card hero-card" style="margin-bottom:18px">
  <div class="eyebrow">MY ACTIVITY</div>
  <h1><%= displayName(artist.name) %>님</h1>
  <p class="muted-text">현재 진행 중인 미션과 제출 현황을 확인해주세요.</p>
  <div class="actions"><a class="button button-secondary" href="/artist/submissions">나의 활동 내역</a></div>
</section>

<div class="artist-grid">
  <div>
    <section class="section-card">
      <div class="section-title"><h2>현재 미션</h2><% if (currentAssignment) { %><span class="badge badge-info">미션 <%= currentAssignment.round_no %></span><% } %></div>
      <% if (!currentAssignment) { %>
        <div class="empty-state">현재 진행 중인 미션이 없습니다.</div>
      <% } else { %>
        <div class="assignment-card">
          <details class="current-mission-details">
            <summary class="current-mission-summary">
              <span class="current-mission-summary-main"><strong>미션 내용</strong><span class="current-mission-summary-title"><%= currentAssignment.title %></span></span>
              <span class="current-mission-icon" aria-hidden="true"></span>
            </summary>
            <div class="current-mission-content">
              <div class="current-mission-row"><span class="detail-label">제목</span><strong><%= currentAssignment.title %></strong></div>
              <div class="current-mission-row"><span class="detail-label">주제</span><span><%= currentAssignment.topic %></span></div>
              <div class="current-mission-row"><span class="detail-label">설명</span><span class="current-mission-description"><%= currentAssignment.description || '등록된 미션 설명이 없습니다.' %></span></div>
            </div>
          </details>
          <div class="assignment-meta"><span>마감 <strong><%= formatDateTime(currentAssignment.due_at) %></strong></span><% if (currentAssignment.recommended_channel) { %><span>권장 채널 <strong><%= currentAssignment.recommended_channel %></strong></span><% } %></div>
          <% if (currentSubmission) { %>
            <div class="actions">
              <span class="badge badge-<%= statusClass(currentSubmission.status) %>"><%= statusLabel(currentSubmission.status) %></span>
              <% if (currentSubmission.status !== 'CONFIRMED') { %><a class="button button-primary" href="/artist/submissions/<%= currentSubmission.submission_id %>/edit">제출 내용 수정</a><% } %>
            </div>
          <% } else { %>
            <a class="button button-primary" href="/artist/submissions/new?assignment_id=<%= currentAssignment.id %>">미션 제출하기</a>
          <% } %>
        </div>

        <div class="peer-submissions">
          <div class="peer-submissions-heading">
            <div>
              <div class="eyebrow">MISSION INSPIRATION</div>
              <h3>다른 작가의 게시물 둘러보기</h3>
              <p class="small-text muted-text">같은 미션을 완료한 작가들의 결과물을 직접 확인해보세요.</p>
            </div>
            <span class="badge badge-info"><%= peerSubmissions.length %>명</span>
          </div>
          <% if (!peerSubmissions.length) { %>
            <div class="empty-state peer-submissions-empty">아직 이 미션을 제출한 다른 작가가 없습니다.</div>
          <% } else { %>
            <div class="peer-submission-list">
              <% peerSubmissions.forEach((submission) => { %>
                <div class="peer-submission-row">
                  <div class="peer-submission-artist">
                    <strong><%= displayName(submission.artist_name) %></strong>
                    <span class="small-text muted-text"><%= submission.upload_channel %></span>
                  </div>
                  <div class="peer-submission-links">
                    <% submission.post_urls.forEach((url, index) => { %>
                      <a class="button button-primary peer-submission-link" href="<%= url %>" target="_blank" rel="noopener noreferrer" title="<%= url %>">
                        게시물 보러가기<% if (submission.post_urls.length > 1) { %> <%= index + 1 %><% } %><span aria-hidden="true">↗</span>
                      </a>
                    <% }) %>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      <% } %>
    </section>

    <section class="section-card">
      <div class="section-title"><div><h2>나의 진행 현황</h2><span class="small-text muted-text">마감 임박순 · 최대 10개</span></div><a href="/artist/submissions" class="small-text">전체 보기</a></div>
      <% if (!activity.length) { %><div class="empty-state">아직 공개된 미션이 없습니다.</div><% } else { %>
        <div class="activity-list">
          <% activity.forEach((item) => { %><div class="activity-row">
            <div class="activity-main"><strong class="activity-title" title="미션 <%= item.round_no %> · <%= item.title %>">미션 <%= item.round_no %> · <%= item.title %></strong><span><%= item.upload_date || '제출 전' %> · <%= item.upload_channel || '채널 미선택' %></span></div>
            <span class="badge badge-<%= statusClass(item.status || 'NOT_SUBMITTED') %>"><%= statusLabel(item.status || 'NOT_SUBMITTED') %></span>
          </div><% }) %>
        </div>
      <% } %>
    </section>
  </div>

  <aside>
    <section class="section-card">
      <div class="section-title"><h2>공지사항</h2></div>
      <% if (!notices.length) { %><div class="empty-state">등록된 공지가 없습니다.</div><% } else { %>
        <div class="notice-list">
          <% notices.forEach((notice) => { %>
            <details class="notice-item artist-notice">
              <summary class="artist-notice-summary">
                <span class="artist-notice-heading">
                  <% if (notice.is_pinned) { %><span class="badge badge-info">고정</span><% } %>
                  <strong class="artist-notice-title" title="<%= notice.title %>"><%= notice.title %></strong>
                </span>
                <span class="artist-notice-icon" aria-hidden="true"></span>
              </summary>
              <div class="artist-notice-body">
                <div class="notice-content"><%= notice.content %></div>
                <div class="muted-text small-text artist-notice-date"><%= formatDateTime(notice.published_at || notice.created_at) %></div>
              </div>
            </details>
          <% }) %>
        </div>
      <% } %>
    </section>

    <% if (nextAssignment) { %>
      <section class="section-card">
        <div class="eyebrow">NEXT MISSION</div><h2>미션 <%= nextAssignment.round_no %></h2><h3><%= nextAssignment.title %></h3><p class="muted-text"><%= nextAssignment.topic %></p><p class="small-text muted-text">공개 시작 <%= formatDateTime(nextAssignment.start_at) %></p>
      </section>
    <% } %>
  </aside>
</div>

<%- include('../partials/artist-foot') %>
