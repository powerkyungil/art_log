<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Art Log</title>
  <link rel="icon" type="image/jpeg" href="/images/sony-logo.jpeg?v=20260818">
  <link rel="apple-touch-icon" href="/images/sony-logo.jpeg?v=20260818">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <main class="center-page">
    <div class="card login-card">
      <div class="wordmark"><img src="/images/sony-logo.jpeg" alt="SONY"></div>
      <div class="eyebrow">ART LOG</div>
      <h1>작가 로그인</h1>
      <p class="muted-text">작가명과 비밀번호로 로그인해주세요.</p>
      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <form method="post" action="/artist/login" class="stack-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>아이디(작가명)<input type="text" name="name" value="<%= loginName %>" autocomplete="username" required></label>
        <label>비밀번호<input type="password" name="password" autocomplete="current-password" required></label>
        <p class="small-text muted-text">최초 비밀번호는 <strong>1234</strong>이며, 로그인 후 변경할 수 있습니다.</p>
        <button class="button button-primary button-full" type="submit">로그인</button>
      </form>
      <a class="back-link" href="/admin/login">관리자 로그인</a>
    </div>
  </main>
</body>
</html>
